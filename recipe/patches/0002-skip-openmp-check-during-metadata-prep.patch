Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] Skip OpenMP test execution during metadata preparation

During metadata preparation, setuptools runs setup.py which calls
check_for_openmp(). This function tries to build and run a test binary,
which can fail with SIGABRT. We should skip the actual test execution
during metadata preparation and only run it during the actual build.

---
 setupext.py | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/setupext.py b/setupext.py
index 0f82b60..a1b2c3d 100644
--- a/setupext.py
+++ b/setupext.py
@@ -1,3 +1,4 @@
+import os
 import subprocess
 import tempfile
 import glob
@@ -40,6 +41,18 @@ def check_for_openmp():
             output = (
                 subprocess.check_output("./test_openmp")
             )
+        except (subprocess.CalledProcessError, FileNotFoundError, OSError) as e:
+            # During metadata preparation, the test_openmp binary may not exist
+            # or may crash. Skip the check during metadata prep to avoid failures.
+            # We can detect metadata prep by checking if we're being called from
+            # setuptools' prepare_metadata_for_build_wheel hook.
+            import sys
+            import traceback
+            tb = traceback.extract_tb(sys.exc_info()[2])
+            # Check if we're being called from setuptools build_meta
+            if any('build_meta' in str(frame.filename) for frame in tb):
+                # During metadata prep, assume OpenMP is available if we got this far
+                # (compilation succeeded, just execution failed)
+                return True
+            raise
         except Exception:
             return False
         finally:

